# Option A - local, free, private (recommended for real mails): Ollama, https://ollama.com
#   install, then: ollama pull qwen2.5:7b   (or llama3.2:3b on small machines)
TRIAGE_LLM_PROVIDER=openai
TRIAGE_LLM_BASE_URL=http://localhost:11434/v1
TRIAGE_LLM_API_KEY=ollama
TRIAGE_LLM_MODEL=qwen2.5:7b

# Option B - free hosted, no card: OpenRouter ":free" models (rate-limited ~50 requests/day, lineup rotates,
#   prompts may be used for training - fine for the fictional demo mails, not for real customer mail)
# TRIAGE_LLM_PROVIDER=openai
# TRIAGE_LLM_BASE_URL=https://openrouter.ai/api/v1
# TRIAGE_LLM_API_KEY=sk-or-...
# TRIAGE_LLM_MODEL=<pick a model id ending in :free from https://openrouter.ai/models?q=free>

# Option C - Groq free tier (fast, OpenAI-compatible)
# The free tier only exposes some models; check the list in your Groq console
# (Settings -> Limits) or GET /models. openai/gpt-oss-120b and qwen/qwen3.8-27b
# are on it (1k requests/day, 8k tokens/min as of Sept 2026).
# Free tier is ~8k tokens/minute: on HTTP 429 the pipeline waits (Retry-After) and retries automatically.
# TRIAGE_LLM_BASE_URL=https://api.groq.com/openai/v1
# TRIAGE_LLM_API_KEY=gsk_...
# TRIAGE_LLM_MODEL=openai/gpt-oss-120b

# Option D - Anthropic API directly
# TRIAGE_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# TRIAGE_MODEL=claude-haiku-4-5-20251001

# Any internal OpenAI-compatible server (vLLM, LM Studio, company gateway) works with Option A's shape.
